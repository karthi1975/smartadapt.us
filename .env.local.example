# Copy to .env.local for local development. None of these are needed in production.

# Log form submissions in the browser console instead of sending them to Formspree.
NEXT_PUBLIC_CONTACT_DRY_RUN=1

# Optional overrides. Defaults live in src/content/site.ts.
# NEXT_PUBLIC_FORMSPREE_FORM_ID=xnpnvrby
# NEXT_PUBLIC_SITE_URL=https://smartadapt.us

# Set to 1 to keep a review copy out of search engines.
# NEXT_PUBLIC_NOINDEX=1
